# ── Backend — configurar en Railway Variables ──────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DEBUG=False

# Railway proporciona DATABASE_URL; o configura las variables individuales:
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# URL del frontend en Vercel (ej: https://daluzed.vercel.app)
CORS_ALLOWED_ORIGINS_EXTRA=https://tu-app.vercel.app

# Railway pone el host automáticamente, agrégalo aquí también:
# ALLOWED_HOSTS=tu-backend.up.railway.app

# ── Frontend — configurar en Vercel Environment Variables ──────────────────
# URL completa del backend en Railway (sin trailing slash)
# VITE_API_URL=https://tu-backend.up.railway.app
