# ──────────────────────────────────────────────────────────────────────────────
# Daluzed Inventario — Variables de entorno para DESARROLLO LOCAL
#
# Copia este archivo a .env (gitignored — NUNCA commitear con credenciales reales):
#   cp .env.example .env     (Linux / Mac / Git Bash)
#   copy .env.example .env   (Windows CMD)
#
# En producción (Railway) estas variables se configuran en el dashboard,
# NO con un archivo .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# DEBUG=True es el default — solo définelo si quieres cambiarlo.
# DEBUG=True

# La clave insegura de desarrollo es el default cuando DEBUG=True.
# DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-in-prod-!!!!

# ── Base de datos PostgreSQL local ────────────────────────────────────────────
# Si usas Docker Compose: DB_HOST=db (nombre del servicio)
# Si usas Postgres instalado directamente: DB_HOST=localhost
DB_NAME=daluzed_db
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# En desarrollo el frontend usa localhost:8000 por defecto (sin VITE_API_URL).
# Solo necesitas esta variable en producción (Vercel → Railway).
# VITE_API_URL=https://pn-daluzed-production.up.railway.app
